{
  "name": "deepseek-harness-client",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop client for DeepSeek Harness: self-hosts `dsh web` and drives it through the reuse of DSH's own protocol packages.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "probe": "tsx scripts/probe.ts",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-schema-form": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^37.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "zustand": "^4.5.5"
  },
  "build": {
    "appId": "com.deepseek.harness.client",
    "productName": "DeepSeek Harness Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-setup.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
